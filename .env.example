# Copy to .env and fill in. Never commit .env.
# Optional: without a key the app still runs with the tap-to-answer advisor and the 12 sample KYC documents.
ANTHROPIC_API_KEY=sk-ant-...

# Models default to claude-haiku-5-5 (lowest cost). Override for higher quality if budget allows:
# ADVISOR_MODEL=claude-sonnet-5-5
# KYC_MODEL=claude-sonnet-5-5
